{
"family": "crud-api-task",
"networkMode": "awsvpc",
"requiresCompatibilities": ["FARGATE"],
"cpu": "256",
"memory": "512",
"executionRoleArn": "arn:aws:iam::575327645493:role/ecstaskexecutionrole",
"taskRoleArn": "arn:aws:iam::575327645493:role/crud-api-ecs",
"containerDefinitions": [
{
"name": "crud-api",
"image": "575327645493.dkr.ecr.us-east-1.amazonaws.com/calculator-api:latest",
"essential": true,
"portMappings": [
{
"containerPort": 3000,
"protocol": "tcp"
}
]
}
]
}
